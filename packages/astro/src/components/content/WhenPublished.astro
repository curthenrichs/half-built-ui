---
import { forwardLinkVisible, type ForwardLinkable } from "../../lib/drafts";

interface Props {
  slug: string;
  posts: ForwardLinkable[];
  showDrafts?: boolean;
}

const { slug, posts, showDrafts = false } = Astro.props;
const visible = forwardLinkVisible(slug, posts, showDrafts);
---

{visible && <slot />}
