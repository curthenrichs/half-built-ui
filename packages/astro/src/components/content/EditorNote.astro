---
interface Props {
  title?: string;
  shown?: boolean;
  class?: string;
}

const {
  title,
  shown = import.meta.env.MODE === "development",
  class: className,
} = Astro.props;

const label = title ? `Editor's Note: ${title}` : "Editor's Note";
---

{shown && <div class:list={["editor-note", "rule-box", className]} role="note">
  <strong class="editor-note-label boxed-label boxed-label-straddle"
    >{label}</strong
  >
  <div class="editor-note-body"><slot /></div>
</div>}

<style>
  /* Box from .rule-box; the dashed amber stroke and the margin are here. */
  .editor-note {
    position: relative;
    border-style: dashed;
    border-color: var(--accent-1);
    margin: 30px 0;
  }

  /* Placement from .boxed-label-straddle; the amber is here. */
  .editor-note-label {
    color: var(--accent-1-ink);
    border-color: var(--accent-1);
  }

  /* Reads as an annotation, not a paragraph: a step smaller than prose. */
  .editor-note-body {
    position: relative;
    font-size: var(--font-size-sm);
    color: var(--accent-1-ink);
  }
  .editor-note-body > :global(:last-child) { margin-bottom: 0; }
</style>
