---
import { resolvePostHref, type Linkable } from "../../lib/drafts";

interface Props {
  slug: string;
  posts: Linkable[];
  tip?: string;
  class?: string;
}

const { slug, posts, tip, class: className } = Astro.props;
const href = resolvePostHref(slug, posts);
---

<a href={href} data-tooltip={tip} class={className}><slot /></a>
