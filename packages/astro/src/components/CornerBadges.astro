---
import { ICON_PLAY, ICON_SPARKLES } from "../scripts/core/icons";

interface Props {
  genai?: boolean;
  demo?: boolean;
  class?: string;
  genaiLabel?: string;
  demoLabel?: string;
}

const {
  genai = false,
  demo = false,
  class: className,
  genaiLabel = "AI Art",
  demoLabel = "Demo",
} = Astro.props;
---

{(genai || demo) && <span class:list={["corner-badges", className]}>
  {genai && <span class="chip badge-genai"
    ><Fragment set:html={ICON_SPARKLES} /> {genaiLabel}</span
  >}
  {demo && <span class="chip badge-demo"
    ><Fragment set:html={ICON_PLAY} /> {demoLabel}</span
  >}
</span>}

<style>
  /* Chip look comes from the .chip pattern; the read-time chip sits
     10px in from the card's bottom-left, so these sit 10px in from the
     bottom-right. */
  .corner-badges {
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: flex;
    gap: 6px;
    z-index: 1;
    line-height: 1;
    pointer-events: none;
  }
</style>
