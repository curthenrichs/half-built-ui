---
import Icon from "./Icon.astro";
import type { Badge } from "../scripts/core/badges";

interface Props {
  badges?: Badge[];
  class?: string;
}

const { badges = [], class: className } = Astro.props;
---

{badges.length > 0 && <span class:list={["corner-badges", className]}>
  {badges.map((badge) => <span class:list={["chip", `badge-${badge.key}`]}>
    <Icon name={badge.icon} /> {badge.label}
  </span>)}
</span>}

<style>
  /* Chip look comes from the .chip pattern; the read-time chip sits
     10px in from the card's bottom-left, so these sit 10px in from the
     bottom-right. */
  .corner-badges {
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: flex;
    gap: 6px;
    z-index: 1;
    line-height: 1;
    pointer-events: none;
  }
</style>
