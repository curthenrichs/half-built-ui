---
import SmartImage from "./SmartImage.astro";
import CornerBadges from "./CornerBadges.astro";
import Icon from "./Icon.astro";
import type { PostCardModel } from "./models";

interface Props extends PostCardModel {
  headingLevel?: 2 | 3 | 4;
  class?: string;
  minReadLabel?: string;
}

const {
  href,
  title,
  excerpt,
  author,
  dateStr,
  minutes,
  hero,
  heroPosition,
  draft = false,
  badges,
  categories,
  headingLevel = 2,
  class: className,
  minReadLabel = "min read",
} = Astro.props;

const Heading: "h2" | "h3" | "h4" = `h${headingLevel}`;
const heroStyle = heroPosition ? `object-position: ${heroPosition}` : undefined;
---

{/* The mapper guarantees an image (a consumer's own placeholder when no
    featured image), so every card takes the thumbnail treatment. */}
<article class:list={["has-post-thumbnail", className]}>
  <div class="post-item post-grid">
    <div class="post-item-image">
      {/* alt divergence kept from pre-step-5: empty on the svg placeholder, title on a real hero; the anchor is aria-hidden either way. */}
      <a class="post-thumbnail" href={href} aria-hidden="true" tabindex="-1">
        <SmartImage
          src={hero}
          alt={hero.format === "svg" ? "" : title}
          widths={[470, 940]}
          sizes="(max-width: 700px) 100vw, 470px"
          style={heroStyle}
        />
      </a>
      {draft && <span class="draft-stamp">DRAFT</span>}
      <div class="card-chips">
        <div class="read-time-comment">
          <span class="reading-time chip">
            <Icon name="clock" size={12} />
            {`${minutes} ${minReadLabel}`}</span>
        </div>
        <CornerBadges badges={badges} />
      </div>
    </div>
    <div class="post-item-content">
      <div class="entry-cat">
        {/* Owner-approved divergence from live (2026-07-28): live wraps the
            category list onto extra rows; ours comma-joins on one line and
            lets the browser ellipsize overflow. Do not restore the flex ul. */}
        <span class="post-categories">
          {categories.map((c, idx) => <Fragment
            >{idx > 0 && ", "}<a href={c.href} rel="category tag"
              >{c.name}</a
            ></Fragment
          >)}
        </span>
      </div>
      <Heading class="entry-title"
        ><a href={href} rel="bookmark">{title}</a></Heading
      >
      <ul class="entry-meta">
        <li class="post-author">
          <Icon name="user" size={11} />
          {author}
        </li>
        <li class="post-date">
          <Icon name="calendar" size={11} />
          {dateStr}
        </li>
      </ul>
      {/* Excerpts arrive display-ready from the migrator (truncation
          ellipsis included when warranted); render verbatim, never decorate. */}
      <div class="post-content">{excerpt}</div>
    </div>
  </div>
</article>

<style>
  .post-item { transition: all 0.5s ease-in-out; }

  /* Same outline as MediaText media and gallery plates (owner request);
     on the container so the hover zoom stays clipped inside it. */
  .post-item-image { position: relative; overflow: hidden; border: var(--stroke) solid var(--rule); }
  .post-item-image a { display: block; height: 100%; width: 100%; line-height: 0; }

  /* The image box clips overflow, so the site-wide ring sits inside. */
  .post-item-image a:focus-visible { outline-offset: -3px; }

  .post-item-image a :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 2.8;
    object-fit: cover;
    transition: all 0.5s ease-in-out;
  }
  .post-item:hover .post-item-image :global(img) { transform: scale(1.07); }

  /* Stamp from the .draft-stamp pattern; the card's size and stacking
     (above the hover-zoomed image) are here. */
  .draft-stamp {
    z-index: 2;
    font-size: var(--font-size-xl);
  }

  /* One row along the image's bottom edge: the read-time chip at the
     left, the corner badges pushed right. wrap-reverse keeps the read
     time on the bottom line and lifts the badges to a line above it
     when a narrow card cannot fit both, instead of overlapping (owner
     catch 2026-09-28). pointer-events: none lets a press fall through
     to the thumbnail link. */
  .card-chips {
    position: absolute;
    right: 10px;
    bottom: 10px;
    left: 10px;
    z-index: 1;
    display: flex;
    flex-wrap: wrap-reverse;
    gap: 6px;
    align-items: flex-end;
    pointer-events: none;
  }

  /* In the row, CornerBadges gives up its own corner placement. */
  .card-chips :global(.corner-badges) {
    position: static;
    margin-left: auto;
  }

  /* Chip look comes from the .chip pattern. display: flex, not a plain
     block: a block wrapper gives the inline-flex chip a text line box
     whose descender gap floats it off the true bottom, so this chip and
     the corner badges (already a flex container) sat at different
     offsets (owner catch 2026-09-06). */
  .read-time-comment {
    display: flex;
  }
  .post-item-content { padding: 15px 0 0; padding-top: 10px; }

  .entry-cat .post-categories {
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;

    /* Each link's box is padded to 24px (WCAG 2.2 target size, 2.5.8).
       The links' font box already stands about 2px taller than this
       line-height:1 row on each side, and overflow clips at the padding
       box, so the row pads 6px to keep the whole 24px box, and with it
       the inset focus/hover ring, inside the clip. The negative margin
       gives the padding back above; below it gives back 2px less,
       because 24px boxes that touch the title link fail 2.5.8's spacing
       check (spec 2026-09-29-wcag-2-2-design.md, owner-approved nudge:
       the title and everything under it sit 2px lower). The smoke tests
       pin the containment and the 24px height. */
    padding-block: 6px;
    margin-block: -6px -4px;
    color: var(--ink);
    text-transform: uppercase;
    font-weight: bold;
    font-size: var(--font-size-xs);
    line-height: 1; /* carried over from the old li a rule; keeps card height */
    letter-spacing: 0.8px;
  }

  .entry-cat .post-categories a {
    padding-block: 4px;
    color: inherit;
    text-decoration: none;
    transition: var(--transition);
  }

  .entry-cat .post-categories a:hover {
    outline: 2px solid currentColor;
    outline-offset: -2px; /* Draws outline inside link to avoid clipping by container overflow */
  }
  .entry-cat .post-categories a:focus-visible { outline-offset: -2px; }

  /* Owner-approved divergence from live (2026-07-26): the live theme
     word-breaks titles mid-word (word-break: break-all); ours wraps at
     word boundaries on purpose. Do not add break-all for fidelity. */
  .entry-title {
    margin-block: 5px 8px;
    line-height: 1.3;
    font-size: var(--font-size-base);
    font-family: var(--font-body);
  }

  .entry-title a {
    color: var(--ink);
    display: inline;
    text-decoration-line: underline;
    transition: var(--transition);
  }
  .entry-title a:hover { outline: 2px solid currentColor; }

  .entry-meta {
    margin: 0 0 10px;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    row-gap: 5px;
    column-gap: 10px;
    align-items: center;
  }

  .entry-meta li {
    margin-bottom: 0;
    font-size: var(--font-size-xs);
    text-transform: capitalize;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .post-content { font-size: var(--font-size-sm); }
</style>
