---
import type { TocItem } from "../lib/toc.ts";

interface Props {
  items: TocItem[];
  label?: string;
}

const { items, label = "Sections" } = Astro.props;
---

{/* The page TOC (#438): one or two heading levels in two forms. Where
    the gutter left of the page fits it, the strip sits open there and
    marks the current section; where it does not, a boxed "Sections (N)"
    disclosure sits in normal flow, for jumping. Place it where the
    disclosure should read: under the page title, or after a post's hero
    image. Its root is display: contents, so the strip sticks for the
    length of the column it is placed in. @half-built/css/toc.css styles
    both forms; mountToc (scripts/toc.ts) picks one and tracks the
    reader, and without it the disclosure shows. Build items with
    lib/toc.ts's tocFromHeadings; when to show a TOC at all is the
    consumer's call. */}
{items.length > 0 && <div class="toc" data-toc>
  <div class="toc-strip" data-toc-strip>
    <div class="toc-panel">
      <p class="toc-label boxed-label" aria-hidden="true">{label}</p>
      <nav aria-label={label}>
        <ul class="toc-links">
          {items.map((item) => <li>
            <a href={`#${item.id}`}>{item.text}</a>
            {item.children.length > 0 && <ul>
              {item.children.map((child) => <li>
                <a href={`#${child.id}`}>{child.text}</a>
              </li>)}
            </ul>}
          </li>)}
        </ul>
      </nav>
    </div>
  </div>
  <details class="toc-inline" data-toc-inline>
    <summary class="toc-inline-summary">{label} ({items.length})</summary>
    <nav class="toc-inline-body" aria-label={label}>
      <ul class="toc-links">
        {items.map((item) => <li>
          <a href={`#${item.id}`}>{item.text}</a>
          {item.children.length > 0 && <ul>
            {item.children.map((child) => <li>
              <a href={`#${child.id}`}>{child.text}</a>
            </li>)}
          </ul>}
        </li>)}
      </ul>
    </nav>
  </details>
</div>}
