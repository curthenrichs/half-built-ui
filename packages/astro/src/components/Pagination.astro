---
import { archivePagePath } from "../lib/paginate";
import Icon from "./Icon.astro";

interface Props {
  current: number;
  total: number;
  base?: string;
  class?: string;
  labels?: { heading?: string; prev?: string; next?: string };
}

const {
  current,
  total,
  base = "",
  class: className,
  labels: labelsOverride = {},
} = Astro.props;

const labels = {
  heading: "Posts pagination",
  prev: "Previous",
  next: "Next",
  ...labelsOverride,
};

const pageHref = (n: number) => archivePagePath(n, base);
---

{total > 1 && <nav
  class:list={["navigation", "pagination", className]}
  aria-label={labels.heading}
>
  <h2 class="screen-reader-text">{labels.heading}</h2>
  <div class="nav-links">
    {current > 1 && <a
      class="prev page-numbers press-box"
      href={pageHref(current - 1)}
    >
      <Icon name="arrow-left" size={14} />
      <span class="screen-reader-text">{labels.prev}</span>
    </a>}
    {Array.from({ length: total }, (_, i) => i + 1).map((n) =>
      n === current ? (
        <span aria-current="page" class="page-numbers current">{n}</span>
      ) : (
        <a class="page-numbers press-box" href={pageHref(n)}>{n}</a>
      ),
    )}
    {current < total && <a
      class="next page-numbers press-box"
      href={pageHref(current + 1)}
    >
      <Icon name="arrow-right" size={14} />
      <span class="screen-reader-text">{labels.next}</span>
    </a>}
  </div>
</nav>}

<style>
  .nav-links {
    display: flex;
    gap: 5px;
    margin: 10px 0 20px;
    justify-content: center;
  }

  .nav-links a,
  .nav-links span {
    text-decoration: none;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition);
    color: var(--ink);
    border: 1px solid var(--ink);
  }

  .nav-links a:hover,
  .nav-links a:focus {
    color: var(--ink);
    border-color: var(--rule);
  }

  /* Press feedback comes from .press-box on the links; the shared rule
     above keeps this site's 1px cell border over the pattern's 2px. */
  .nav-links span.current {
    color: var(--on-ink);
    background-color: var(--ink);
    border-color: var(--rule);
  }
</style>
