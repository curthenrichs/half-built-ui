---
/* Pagination matching the live WordPress markup: nav.navigation.pagination
   with .nav-links containing .page-numbers boxes and Prev/Next arrows. */
import { archivePagePath } from "../lib/paginate";

interface Props {
  current: number;
  total: number;
  base?: string;
  class?: string;
  labels?: { heading?: string; prev?: string; next?: string };
}

const {
  current,
  total,
  base = "",
  class: className,
  labels: labelsOverride = {},
} = Astro.props;

const labels = {
  heading: "Posts pagination",
  prev: "Previous",
  next: "Next",
  ...labelsOverride,
};

const pageHref = (n: number) => archivePagePath(n, base);
---

{total > 1 && (
  <nav
    class:list={["navigation", "pagination", className]}
    aria-label={labels.heading}
  >
    <h2 class="screen-reader-text">{labels.heading}</h2>
    <div class="nav-links">
      {current > 1 && (
        <a class="prev page-numbers press-box" href={pageHref(current - 1)}>
          <svg
            viewBox="0 0 448 512"
            width="12"
            height="12"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M257.5 445.1l-22.2 22.2c-9.4 9.4-24.6 9.4-33.9 0L7 273c-9.4-9.4-9.4-24.6 0-33.9L201.4 44.7c9.4-9.4 24.6-9.4 33.9 0l22.2 22.2c9.5 9.5 9.3 25-.4 34.3L136.6 216H424c13.3 0 24 10.7 24 24v32c0 13.3-10.7 24-24 24H136.6l120.5 114.8c9.8 9.3 10 24.8.4 34.3z" />
          </svg>
          <span class="screen-reader-text">{labels.prev}</span>
        </a>
      )}
      {Array.from({ length: total }, (_, i) => i + 1).map((n) =>
        n === current ? (
          <span aria-current="page" class="page-numbers current">
            {n}
          </span>
        ) : (
          <a class="page-numbers press-box" href={pageHref(n)}>
            {n}
          </a>
        ),
      )}
      {current < total && (
        <a class="next page-numbers press-box" href={pageHref(current + 1)}>
          <svg
            viewBox="0 0 448 512"
            width="12"
            height="12"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M190.5 66.9l22.2-22.2c9.4-9.4 24.6-9.4 33.9 0L441 239c9.4 9.4 9.4 24.6 0 33.9L246.6 467.3c-9.4 9.4-24.6 9.4-33.9 0l-22.2-22.2c-9.5-9.5-9.3-25 .4-34.3L311.4 296H24c-13.3 0-24-10.7-24-24v-32c0-13.3 10.7-24 24-24h287.4L190.9 101.2c-9.8-9.3-10-24.8-.4-34.3z" />
          </svg>
          <span class="screen-reader-text">{labels.next}</span>
        </a>
      )}
    </div>
  </nav>
)}

<style>
  .nav-links {
    display: flex;
    gap: 5px;
    margin: 10px 0 20px;
    justify-content: center;
  }

  .nav-links a,
  .nav-links span {
    text-decoration: none;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition);
    color: var(--ink);
    border: 1px solid var(--ink);
  }

  .nav-links a:hover,
  .nav-links a:focus {
    color: var(--ink);
    border-color: var(--rule);
  }

  /* Press feedback comes from .press-box on the links; the shared rule
     above keeps this site's 1px cell border over the pattern's 2px. */
  .nav-links span.current {
    color: var(--on-ink);
    background-color: var(--ink);
    border-color: var(--rule);
  }
</style>
