---
/* Fixed palette editor (Task 5; top right on desktop, bottom right on
   phones since the 2026-09-06 owner call). Markup only: the live
   derivation and persistence is palette-editor.ts's mountPaletteEditor,
   wired from Base.astro's script block. Unlike Toc.astro this renders
   from Base.astro itself, outside the .site-layout wrapper, so it sits
   above every page's content rather than beside one page's sections.
   The day/night toggle stays in the header; this panel is palette
   only. Styling lives in ../styles/site.css under the shared @layer
   site, not a component <style>, so it can share tokens with the rest
   of the site's own layout rules in one place. The theme toggle here
   is a third instance of the package component (owner call 2026-09-06:
   the panel carries the light/dark control too); the island keeps
   every toggle on the page in step. */
import ThemeToggle from "@half-built/astro/components/ThemeToggle.astro";
import { ICON_X } from "@half-built/astro/scripts/core/icons.ts";
---
<aside class="site-toolbar">
  <details data-palette-editor>
    <summary>
      <span class="site-toolbar-swatch site-toolbar-swatch-1" aria-hidden="true"></span>
      <span class="site-toolbar-swatch site-toolbar-swatch-2" aria-hidden="true"></span>
      Palette
    </summary>
    <div class="site-toolbar-body">
      <button type="button" data-palette-close class="icon-box site-toolbar-close" aria-label="Close palette">
        <Fragment set:html={ICON_X} />
      </button>
      <div class="site-toolbar-scroll">
      <div class="site-toolbar-field">
        <input type="color" id="palette-base-1" data-palette-base="1" value="#ffaa3c" />
        <label for="palette-base-1">Accent 1</label>
        <ThemeToggle label="Switch theme" class="site-toolbar-rowend" />
      </div>
      <div class="site-toolbar-field">
        <input type="color" id="palette-base-2" data-palette-base="2" value="#3cc7dd" />
        <label for="palette-base-2">Accent 2</label>
        <button type="button" data-palette-flip class="site-toolbar-flip site-toolbar-rowend" title="Swap accent 1 and accent 2">Flip</button>
      </div>
      <ul data-palette-readouts class="site-toolbar-readouts"></ul>
      <details class="site-toolbar-more">
        <summary>Show details</summary>
        <ul data-palette-detail class="site-toolbar-readouts"></ul>
      </details>
      <p class="site-toolbar-caption" id="palette-presets-label">Presets</p>
      <div class="site-toolbar-presets" role="group" aria-labelledby="palette-presets-label">
        <button type="button" data-palette-preset data-base-1="#ffaa3c" data-base-2="#3cc7dd">Amber</button>
        <button type="button" data-palette-preset data-base-1="#1890ff" data-base-2="#13c2c2">Blues</button>
        <button type="button" data-palette-preset data-base-1="#2f9e44" data-base-2="#0ca678">Greens</button>
        <button type="button" data-palette-preset data-base-1="#f2545b" data-base-2="#ff9e7a">Reds</button>
      </div>
      <details class="site-toolbar-more">
        <summary>Show CSS</summary>
        <pre data-palette-css class="site-toolbar-css"></pre>
      </details>
      <div class="site-toolbar-actions">
        <button type="button" data-palette-copy>Copy CSS</button>
        <button type="button" data-palette-reset>Reset</button>
      </div>
      </div>
    </div>
  </details>
</aside>
