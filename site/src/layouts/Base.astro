---
/* The demo site's one layout, wired the same way the blog's Base.astro
   wires the package it now consumes: Shell for the document frame,
   Masthead and Footer for the chrome, and the standard island set
   mounted in the body-end script. Every import here is a package
   specifier (@half-built/...); nothing reaches into a package's own
   src directory by relative path. */
import "@half-built/css/layers";
import "@half-built/css/tokens";
import "@half-built/css";
import "@half-built/css/patterns.css";
import "@half-built/css/code.css";
import "@half-built/css/plate-modal.css";
import "@half-built/css/lightbox.css";
import "@half-built/css/prose.css";
import "../styles/site.css";
import Shell from "@half-built/astro/components/Shell.astro";
import Masthead from "@half-built/astro/components/Masthead.astro";
import Footer from "@half-built/astro/components/Footer.astro";
import { formatHeaderDate } from "@half-built/astro/lib/header-date";
import {
  SITE_NAME,
  TAGLINE,
  NAV,
  SOCIALS,
  LEGAL_HOLDER,
  FOOTER_SITEMAP,
  ECOSYSTEM,
  ECOSYSTEM_SELF,
} from "../data/site";
import { THEME_STORAGE_KEY } from "../lib/theme-key";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "half-built-ui",
  description = "The reference site for the @half-built packages, every component's variants rendered on one page.",
} = Astro.props;
---

<Shell themeStorageKey={THEME_STORAGE_KEY}>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* The half-built gear (owner calls 2026-09-06): colorless on
        purpose, neutral ink that flips with the browser scheme; the
        raster fallbacks bake the neutral ink tile. No accent in any
        icon, because the site's whole pitch is live re-theming. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#ffffff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#111111"
    />
    {/* Canonical and share tags, kept site-side rather than in the
        package: every value here is this site's own identity, which is
        the same call the blog's Seo.astro records. Both URLs resolve
        against astro.config's `site`. The card is a static PNG, so it
        carries no accent color, per the rule that anything which cannot
        follow the palette live stays neutral. */}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={new URL("/og-card.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="The half-built gear mark beside the half-built-ui name"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </Fragment>
  <Masthead
    slot="header"
    siteName={SITE_NAME}
    tagline={TAGLINE}
    nav={NAV}
    socials={SOCIALS}
    dateStr={formatHeaderDate(new Date())}
    isHome={true}
  />
  {/* The palette editor and TOC merged into Rail.astro (owner call
      2026-09-06), rendered by the page inside .site-layout's column
      rather than floating from this layout. */}
  <slot />
  <Footer
    slot="footer"
    siteName={SITE_NAME}
    legalHolder={LEGAL_HOLDER}
    sitemap={FOOTER_SITEMAP}
    ecosystem={ECOSYSTEM}
    ecosystemSelf={ECOSYSTEM_SELF}
  />
  <Fragment slot="scripts">
    <script>
      import { mountCodeIslands } from "@half-built/astro/scripts/code-island";
      import { mountLightbox } from "@half-built/astro/scripts/lightbox";
      import { mountLinkTips } from "@half-built/astro/scripts/link-tip";
      import { mountThemeToggle } from "@half-built/astro/scripts/theme-toggle";
      import { mountFocusMode } from "@half-built/astro/scripts/focus-mode";
      import { mountScrollTop } from "@half-built/astro/scripts/scroll-top";
      import { mountEcosystem } from "@half-built/astro/scripts/ecosystem";
      import { mountToc } from "../scripts/toc";
      import { mountPaletteEditor } from "../scripts/palette-editor";
      import { mountTokenHexes } from "../scripts/token-hexes";
      import { THEME_STORAGE_KEY } from "../lib/theme-key";
      import { PALETTE_STORAGE_KEY } from "../lib/palette-key";
      import {
        ECOSYSTEM_SELF_KEY,
        ECOSYSTEM_ENDPOINT,
      } from "../lib/ecosystem-config";
      mountFocusMode(document.documentElement);
      /* Internal and external links share one measured tooltip island. */
      mountLinkTips(document, { selector: 'a[href^="http"], a[data-tooltip]' });
      mountThemeToggle(document, { storageKey: THEME_STORAGE_KEY });
      mountScrollTop(document);
      mountCodeIslands(document);
      mountLightbox(document);
      mountToc(document);
      mountPaletteEditor(document, { storageKey: PALETTE_STORAGE_KEY });
      mountTokenHexes(document);
      /* Guarded, so a site with no endpoint configured makes no
         request at all. Bundlers drop the island entirely while the
         constant is null. */
      if (ECOSYSTEM_ENDPOINT !== null) {
        /* Every known throw site inside mountEcosystem is already
           guarded, so this catch is belt and braces against an
           unexpected rejection surfacing as an unhandled console
           error. Either way the server-rendered baseline stands. */
        void mountEcosystem(document, {
          endpoint: ECOSYSTEM_ENDPOINT,
          selfKey: ECOSYSTEM_SELF_KEY,
        }).catch(() => {});
      }
    </script>
    <slot name="scripts" />
  </Fragment>
</Shell>
