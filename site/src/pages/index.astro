    title: "Sample post, marked draft",
    excerpt: "A second placeholder excerpt, this card flagged as a draft.",
    author: "Demo Author",
    dateStr: "2, Jan 2026",
    minutes: 6,
    hero: placeholderWide,
    draft: true,
    categories: [
      { name: "Sample", href: "#" },
      { name: "Demo", href: "#" },
    ],
  },
  {
    href: "#",
    title: "Sample post, with corner badges",
    excerpt:
      "A third placeholder excerpt, showing the AI Art and Demo badges together.",
    author: "Demo Author",
    dateStr: "3, Jan 2026",
    minutes: 3,
    hero: placeholderWide,
    badges: [GENAI_BADGE, DEMO_BADGE],
    categories: [{ name: "Demo", href: "#" }],
  },
];

const excerptSampleBody = `A short aside that opens the sample post and
should stay off the card.

<ExcerptStart />

The card text starts here, after the marker, and runs until
the excerpt limit cuts it at a word boundary with an ellipsis.`;

const excerptCard: PostCardModel = {
  href: "#",
  title: "Sample post, excerpt after a marker",
  excerpt: deriveExcerpt(excerptSampleBody) ?? "",
  author: "Demo Author",
  dateStr: "4, Jan 2026",
  minutes: 2,
  hero: placeholderWide,
  categories: [{ name: "Sample", href: "#" }],
};

const typeScale = ["xs", "sm", "base", "md", "lg", "xl", "xxl"];

const categoryCards = [
  { name: "Sample", href: "#", image: placeholderSquare },
  { name: "Demo", href: "#", image: placeholderTall },
];

const prevPost: PostRef = { href: "#", title: "Older placeholder post" };
const nextPost: PostRef = { href: "#", title: "Newer placeholder post" };

const linkListItems: LinkListItem[] = [
  { label: "Item one", href: "#", count: 3 },
  { label: "Item two", href: "#", count: 1 },
  { label: "Item three", href: "#" },
];

const tokenEntries = [
  { role: "--ink", token: "--ink", note: "Body text and rules" },
  { role: "--surface", token: "--surface", note: "The page ground" },
  { role: "--rule", token: "--rule", note: "Borders and frames" },
  { role: "--accent-1", token: "--accent-1", note: "Accent 1 lines and fills" },
  {
    role: "--accent-1-ink",
    token: "--accent-1-ink",
    note: "Accent 1 as readable text",
  },
  { role: "--accent-2", token: "--accent-2", note: "Accent 2 lines and fills" },
  {
    role: "--accent-2-ink",
    token: "--accent-2-ink",
    note: "Accent 2 as readable text",
  },
  {
    role: "--error-ink",
    token: "--error-ink",
    note: "The error callout's line and label",
  },
  {
    role: "--code-token-function",
    token: "--code-token-function",
    note: "Function names in code",
  },
  {
    role: "--code-token-string",
    token: "--code-token-string",
    note: "Strings and constants in code",
  },
];

import primitivesSheet from "@half-built/css/tokens/primitives.css?raw";

const STOP = /^(\d+|a\d+|vivid|dim)$/;

const stopOrder = (stop: string): number => {
  if (stop === "plain") return -1;
  if (/^\d+$/.test(stop)) return Number(stop);
  const accentRank = stop.startsWith("a") ? 100 + Number(stop.slice(1)) : 0;

  return 1000 + ["vivid", "dim"].indexOf(stop) + accentRank;
};

const ramps = new Map<string, Map<string, string>>();

for (const m of primitivesSheet.matchAll(
  /--([a-z0-9-]+):\s*((?:#|rgba?\()[^;]+);/g,
)) {
  const [, name, value] = m;
  const parts = name.split("-");
  const last = parts[parts.length - 1];
  const stop = STOP.test(last) ? last : "plain";
  const family = stop === "plain" ? name : parts.slice(0, -1).join("-");
  const row = ramps.get(family) ?? new Map<string, string>();
  row.set(stop, value.trim());
  ramps.set(family, row);
}

const rampStops = [
  ...new Set([...ramps.values()].flatMap((row) => [...row.keys()])),
].sort((a, b) => stopOrder(a) - stopOrder(b));

const rampRows = [...ramps.entries()].map(([family, row]) => ({
  family,
  cells: rampStops.map((stop) => row.get(stop) ?? ""),
}));

const samplePosts = [
  {
    data: {
      slug: "sample-published",
      date: new Date("2026-09-01T00:00:00Z"),
      draft: false,
    },
  },
  {
    data: {
      slug: "sample-draft",
      date: new Date("2026-09-08T00:00:00Z"),
      draft: true,
    },
  },
];

const codeSample = `def read_ir(code):
    return "power" if code == 0x40BF else "unknown"`;

const frameImports = `import Masthead from "@half-built/astro/components/Masthead.astro";
import Footer from "@half-built/astro/components/Footer.astro";
import ThemeToggle from "@half-built/astro/components/ThemeToggle.astro";
import TwoColumn from "@half-built/astro/components/TwoColumn.astro";`;

const cardImports = `import PostCard from "@half-built/astro/components/PostCard.astro";
import CategoryCard from "@half-built/astro/components/CategoryCard.astro";
import { deriveExcerpt } from "@half-built/astro/lib/excerpt.ts";
import ExcerptStart from "@half-built/astro/content/ExcerptStart.astro";`;

const componentImports = `import Pagination from "@half-built/astro/components/Pagination.astro";
import PostNavigation from "@half-built/astro/components/PostNavigation.astro";
import Widget from "@half-built/astro/components/Widget.astro";
import LinkListWidget from "@half-built/astro/components/LinkListWidget.astro";
import Subscribe from "@half-built/astro/components/Subscribe.astro";
import Button from "@half-built/astro/content/Button.astro";
import Callout from "@half-built/astro/content/Callout.astro";
import EditorNote from "@half-built/astro/content/EditorNote.astro";
import WhenPublished from "@half-built/astro/content/WhenPublished.astro";
import PostLink from "@half-built/astro/content/PostLink.astro";
import Group from "@half-built/astro/content/Group.astro";
import CodeBlock from "@half-built/astro/content/CodeBlock.astro";
import Spacer from "@half-built/astro/content/Spacer.astro";
import Quote from "@half-built/astro/content/Quote.astro";
import Walkthrough from "@half-built/astro/content/Walkthrough.astro";
import Step from "@half-built/astro/content/Step.astro";
import Gallery from "@half-built/astro/content/Gallery.astro";
import GalleryImage from "@half-built/astro/content/GalleryImage.astro";
import BlogImage from "@half-built/astro/content/BlogImage.astro";
import MediaText from "@half-built/astro/content/MediaText.astro";
import Popout from "@half-built/astro/components/Popout.astro";`;

const cssImports = `import "@half-built/css/tokens";
import "@half-built/css/prose.css";
import "@half-built/css/patterns.css";
import Palette from "@half-built/astro/content/Palette.astro";`;

const popoutLayoutSample = `---
import "@half-built/css/popout.css";
---

<script>
  import { mountPopouts } from "@half-built/astro/scripts/popout.ts";

  mountPopouts(document);
</script>`;

const popoutMarkupSample = `---
import Popout from "@half-built/astro/components/Popout.astro";
---

<Popout label="Row one">
  A note can carry a <a href="#components">link</a> and
  <code>inline code</code>.
</Popout>`;

const pathPlayerSample = `---
import "@half-built/css/plate-modal.css";
import "@half-built/css/path-player.css";
---

<script>
  import { createPathPlayer } from "@half-built/astro/scripts/path-player.ts";

  const player = createPathPlayer(document, {
    title, source, caption, duration, samples, tracks,
    buildStage: (viewbox) => { /* append the stage, return true */ },
    sink: { start, move, stop },
  });

  button.addEventListener("click", () => player.open(button));
</script>`;

const npmPackages = [
  {
    name: "@half-built/css",
    href: "https://www.npmjs.com/package/@half-built/css",
  },
  {
    name: "@half-built/astro",
    href: "https://www.npmjs.com/package/@half-built/astro",
  },
  {
    name: "@half-built/tooling",
    href: "https://www.npmjs.com/package/@half-built/tooling",
  },
];
---

<Base
  isHome
  title="half-built-ui"
  description="The reference site for the @half-built packages, every component's variants rendered on one page."
>
  <div class="site-layout">
    <Rail />
    <main>
      <article class="static-page bracket-frame">
        <h1>half-built-ui</h1>

        <section id="intro">
          <div class="prose">
            <h2>About</h2>
            <div class="section-intro" data-section-intro="intro">
              <p>
                This page renders every component in the half-built design
                system. The system was extracted from
                <a href="https://half-built-robots.com">half-built-robots.com</a
                >, which now references these packages. All three packages are
                published on npm under MIT.
              </p>
              <p>
                The palette editor in the corner rewrites the theming variables
                live and prints a block ready to paste into a stylesheet. That
                block is the entire theming surface, eight brand stops plus the
                four values behind the code viewer. The viewer highlights
                through those variables, so syntax colors and the block they sit
                on follow the palette as well.
              </p>
            </div>
            <!-- A real CodeBlock, not an inline code span, so the code
               island mounts its COPY button on the install line (owner
               ask 2026-09-06). -->
            <CodeBlock>
              <Code
                code="npm install @half-built/css @half-built/astro @half-built/tooling"
                lang="shellscript"
                theme={codeTheme}
                transformers={[codeVars]}
              />
            </CodeBlock>
            <ul class="demo-npm-links">
              {npmPackages.map((pkg) => <li>
                <a href={pkg.href}><code>{pkg.name}</code></a>
              </li>)}
            </ul>
          </div>
        </section>

        <section id="frame">
          <div class="prose">
            <h2>Frame</h2>
            <div class="section-intro" data-section-intro="frame">
              <p>
                The header and footer come from the package and know nothing
                about the site around them. The site name and the rest of the
                identity arrive as typed props. The theme toggle sits in the
                header, and the palette panel carries a second instance beside
                the color pickers. Every toggle on a page stays in step, so
                flipping either one moves the other.
              </p>
            </div>
            <Imports code={frameImports} />
          </div>

          <h3>Two-column layout</h3>
          <div class="prose">
            <p>
              TwoColumn is the page row: the main column and a sidebar beside
              it. The sidebar takes 30% of the row and stacks under the main
              column at the sidebar breakpoint. The frame below stands in for
              the page.
            </p>
          </div>
          <div class="demo-two-column">
            <TwoColumn mainTag="div">
              <div class="prose">
                <p>
                  The main column. Post bodies, archives and static pages render
                  here, and it takes whatever width the sidebar leaves.
                </p>
                <p>
                  A second placeholder paragraph, to give the column some length
                  beside the sidebar.
                </p>
              </div>
              <aside class="sidebar" slot="aside" aria-label="Sample sidebar">
                <LinkListWidget
                  title="Sidebar links"
                  items={linkListItems}
                  headingLevel={4}
                />
              </aside>
            </TwoColumn>
          </div>
        </section>

        <section id="cards">
          <div class="prose">
            <h2>Cards</h2>
            <div class="section-intro" data-section-intro="cards">
              <p>
                PostCard is the card an archive page is made of. The second one
                here is flagged as a draft, and that badge exists so an
                unfinished post can ship where people can see it. The third
                wears the corner badges, one for an AI-generated image and one
                for a post carrying an interactive demo. CategoryCard is the
                smaller tile, an image with the category name chipped over its
                bottom edge.
              </p>
              <p>
                A card's text is derived from the post body. The card under
                Derived excerpt starts after an <code>ExcerptStart</code>
                marker, skipping the aside above it.
              </p>
            </div>
            <Imports code={cardImports} />
          </div>

          <h3>Post cards</h3>
          <div class="demo-card-grid">
            {posts.map((post) => (
              <PostCard {...post} />
            ))}
          </div>

          <h3>Derived excerpt</h3>
          <div class="prose">
            <p>
              The sample post body runs through <code>deriveExcerpt</code> to
              make the card's text. The text before the marker stays off the
              card.
            </p>
          </div>
          <div class="demo-excerpt">
            <div class="prose">
              <CodeBlock filename="sample-post.mdx">
                <Code
                  code={excerptSampleBody}
                  lang="mdx"
                  theme={codeTheme}
                  transformers={[codeVars]}
                />
              </CodeBlock>
            </div>
            <div class="demo-card-grid">
              <PostCard {...excerptCard} />
            </div>
          </div>

          <h3>Category cards</h3>
          <div class="demo-card-grid demo-card-grid-narrow">
            {categoryCards.map((c) => (
              <CategoryCard name={c.name} href={c.href} image={c.image} />
            ))}
          </div>
        </section>

        <section id="components">
          <div class="prose">
            <h2>Components</h2>
            <div class="section-intro" data-section-intro="components">
              <p>
                The rest of the package, from the navigation rows to the blocks
                a post body is built from. Imports split between
                <code>components/</code> for page chrome and
                <code>content/</code> for post bodies. The split is only where
                the files live. Nothing in this system caps the width of text.
                The layout's column is the only width authority.
              </p>
            </div>
            <Imports code={componentImports} />
          </div>

          <div class="prose">
            <h3>Pagination</h3>
            <p>
              The numbered row at the foot of an archive. It renders nothing
              when there is only one page.
            </p>
          </div>
          <Pagination current={2} total={4} base="#" />

          <div class="prose">
            <h3>Post navigation</h3>
            <p>
              The pair of links at the end of a post. The newer post sits on the
              left and the older one on the right, matching the newest-first
              order the archives read in.
            </p>
          </div>
          <PostNavigation prev={prevPost} next={nextPost} />

          <div class="prose">
            <h3>Link list widget and Widget</h3>
            <p>
              Widget is a heading over whatever sits in its body. LinkListWidget
              is that same block filled with links and their counts.
            </p>
          </div>
          <div class="demo-widget-row">
            <LinkListWidget title="Sample links" items={linkListItems} />
            <Widget title="Plain widget">
              <p>
                A Widget with arbitrary content in its body, rather than the
                link-list shape above.
              </p>
            </Widget>
          </div>

          <div class="prose">
            <h3>Popout</h3>
            <p>
              A short note behind a cell in a data table, for detail worth
              keeping but not worth a column. On a wide screen it opens below
              its trigger, or above it when there is no room below. It closes on
              its own when the trigger scrolls out of view, when keyboard focus
              leaves it, or when the window crosses into phone width. On a phone
              it opens as a sheet from the bottom edge, captioned with its row.
              The layout loads <code>popout.css</code> and mounts
              <code>mountPopouts</code> once.
            </p>
            <section class="table-scroll" tabindex="0" aria-label="Popout demo">
              <table>
                <thead>
                  <tr>
                    <th>Row</th>
                    <th>Value</th>
                    <th>Notes</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Row one</td>
                    <td>42</td>
                    <td>
                      <Popout label="Row one" id="demo-popout-1">
                        A note can carry a <a href="#components">link</a> and
                        <code>inline code</code>.
                      </Popout>
                    </td>
                  </tr>
                  <tr>
                    <td>Row two</td>
                    <td>7</td>
                    <td>
                      <Popout label="Row two" id="demo-popout-2">
                        One popout is open at a time. Opening this one closed
                        the other.
                      </Popout>
                    </td>
                  </tr>
                  <tr>
                    <td>Row three</td>
                    <td>19</td>
                    <td></td>
                  </tr>
                </tbody>
              </table>
            </section>
            <div class="demo-popout-sample">
              <CodeBlock>
                <Code
                  code={popoutLayoutSample}
                  lang="astro"
                  theme={codeTheme}
                  transformers={[codeVars]}
                />
              </CodeBlock>
              <CodeBlock>
                <Code
                  code={popoutMarkupSample}
                  lang="astro"
                  theme={codeTheme}
                  transformers={[codeVars]}
                />
              </CodeBlock>
            </div>
          </div>

          <div class="prose">
            <h3>Path player</h3>
            <p>
              A transport and timeline over a plate modal. The caller supplies
              the samples, the tracks under the stage, and the stage itself.
              This stage is a point on a closed curve. With reduced motion set,
              it opens paused.
            </p>
            <p class="button-row">
              <Button variant="accent-1" class="demo-path-player"
                >Open the path player</Button
              >
            </p>
            <CodeBlock>
              <Code
                code={pathPlayerSample}
                lang="astro"
                theme={codeTheme}
                transformers={[codeVars]}
              />
            </CodeBlock>
          </div>

          <div class="prose">
            <h3>Subscribe</h3>
            <p>
              A real form with a method and an action, which submits with
              JavaScript turned off. Its copy sits in named slots, so the words
              can be overridden without forking the component.
            </p>
          </div>
          <Subscribe
            variant="page"
            action="https://example.com/subscribe"
            publicUrl="example.com/subscribe"
          >
            <Fragment slot="fine-print"
              >Placeholder form. This demo does not send email. The action is
              not a real endpoint.</Fragment
            >
          </Subscribe>

          <div class="prose">
            <h3>Button</h3>
            <p>Four variants, two sizes.</p>
            <p class="button-row">
              <Button variant="plain">Plain</Button>
              <Button variant="shaded">Shaded</Button>
              <Button variant="accent-1">Accent 1</Button>
              <Button variant="accent-2" size="lg">Accent 2, large</Button>
            </p>
            <p>A lone call to action takes the centered row.</p>
            <p class="button-row button-row-center">
              <Button variant="accent-2" href="#"
                >Centered call to action</Button
              >
            </p>

            <h3>Callout</h3>
            <p>
              An aside set apart from the body, for a caveat, a warning, or a
              result the reader should not skim past. The type sets the label
              and the line color.
            </p>
            <Callout type="note">A note callout, the default look.</Callout>
            <Callout type="info"
              >An info callout, graphite like the note. The label tells them
              apart.</Callout
            >
            <Callout type="tip" title="Tip"
              >A tip callout, wearing the first accent.</Callout
            >
            <Callout type="warning"
              >A warning callout, the first accent again.</Callout
            >
            <Callout type="success"
              >A success callout, wearing the second accent.</Callout
            >
            <Callout type="error">An error callout, in the red family.</Callout>

            <h3>Editor's note</h3>
            <p>
              A note to the author that renders only on a dev server. A deploy
              build emits nothing for it, so it can sit in published content as
              a standing to-do. This one is forced visible with the
              <code>shown</code> prop.
            </p>
            <EditorNote title="Demo" shown={true}
              >A demo note, forced visible. The dashed rule is the tell. Nothing
              else in the system is dashed.</EditorNote
            >

            <h3>When published and Post link</h3>
            <p>
              Both take the consumer's post collection as a prop and read no
              content of their own. <code>PostLink</code> resolves a slug to the
              post's dated URL at build time, and renders plain text in place of
              a link while the post is a draft. <code>WhenPublished</code>
              renders its passage only once the post it names is visible, and
              its optional <code>fallback</code> slot renders until then. The
              sample collection here has one published post and one draft.
            </p>
            <WhenPublished slug="sample-published" posts={samplePosts}>
              <p>
                This passage is visible because its post is published. It links
                to
                <PostLink
                  slug="sample-published"
                  posts={samplePosts}
                  tip="Sample post (September 1, 2026)"
                  >the sample post</PostLink
                >, whose URL was resolved from the slug.
              </p>
              <p slot="fallback">This fallback never renders.</p>
            </WhenPublished>
            <p class="sample-pending-link">
              This sentence names
              <PostLink
                slug="sample-draft"
                posts={samplePosts}
                tip="Sample draft"
                >the sample draft</PostLink
              >
              in plain text, because its post is still a draft. It becomes a
              link when the post ships.
            </p>
            <WhenPublished slug="sample-draft" posts={samplePosts}>
              <p class="sample-draft-passage">
                This passage never renders, because its post is a draft.
              </p>
            </WhenPublished>
            <WhenPublished slug="sample-draft" posts={samplePosts}>
              <p>
                This passage waits for
                <PostLink slug="sample-draft" posts={samplePosts}
                  >the draft</PostLink
                >.
              </p>
              <p slot="fallback">
                This fallback stands in while the draft is unpublished.
              </p>
            </WhenPublished>

            <h3>Group</h3>
            <Group
              ><p>
                A boxed prose container, no label and no tint, the plain sibling
                of Callout's box.
              </p></Group
            >

            <h3>Code block</h3>
            <CodeBlock filename="example.py">
              <Code
                code={codeSample}
                lang="python"
                theme={codeTheme}
                transformers={[codeVars]}
              />
            </CodeBlock>

            <h3>Spacer</h3>
            <p>A fixed-height spacer sits below this paragraph.</p>
            <Spacer size={60} />
            <p>Normal flow resumes here, after the spacer.</p>

            <h3>Quote</h3>
            <Quote by="Demo Author" when="2026"
              >A quoted line, with an attribution footer.</Quote
            >

            <h3>Walkthrough and Step</h3>
            <Walkthrough numbered>
              <Step src={placeholderSquare} alt="Placeholder step photo, one"
                >First step. One placeholder photo beside its text.</Step
              >
              <Step src={placeholderSquare} alt="Placeholder step photo, two"
                >Second step. Numbering runs down the media column's corner
                chip.</Step
              >
            </Walkthrough>

            <h3>Gallery</h3>
            <Gallery
              columns={3}
              caption="Three placeholder plates in a bracket frame."
            >
              <GalleryImage
                src={placeholderSquare}
                alt="Placeholder gallery plate, one"
                caption="Plate one"
              />
              <GalleryImage
                src={placeholderSquare}
                alt="Placeholder gallery plate, two"
                caption="Plate two"
              />
              <GalleryImage
                src={placeholderSquare}
                alt="Placeholder gallery plate, three"
                caption="Plate three"
              />
            </Gallery>

            <h3>Blog image</h3>
            <BlogImage
              src={placeholderWide}
              alt="Wide placeholder image"
              caption="A full-width figure with a caption, wearing the AI Art badge."
              badges={[GENAI_BADGE]}
            />

            <h3>Media text</h3>
            <MediaText src={placeholderTall} alt="Tall placeholder image">
              <p>
                Media on one side, prose on the other. This is the caption slot,
                and it takes a short paragraph rather than a single line. On a
                phone the two stack, image first, and the prose centers under it
                like a figure caption.
              </p>
            </MediaText>
          </div>
        </section>

        <section id="css">
          <div class="prose">
            <h2>CSS primitives</h2>
            <div class="section-intro" data-section-intro="css">
              <p>
                The tokens are the variables everything else reads, and every
                color on this page resolves through them. The palette editor
                repaints the page by setting twelve. Each value is tuned to
                clear WCAG AA against the ground it sits on. The prose and
                pattern sheets carry the rest, the paragraph rhythm and the
                boxes.
              </p>
            </div>
            <Imports code={cssImports} />
          </div>

          <h3>Table</h3>
          {/* Inside prose scope on purpose: the boxed ledger table
            treatment lives in prose.css as .prose table, which is how
            every table on the blog wears it. Outside this wrapper a
            table renders bare. The specimen's rows are the system's
            own breakpoints (tokens/breakpoints.css), real data rather
            than filler; the token sheet and the Patterns ledger below
            wear the same treatment. */}
          <div class="prose">
            <p>
              The boxed ledger every table in the system wears. Wide tables
              scroll inside their own box, so the page never scrolls sideways.
            </p>
            {/* Scroll boxes are named sections, so tab stops with a
              landmark name: a region that scrolls sideways and a
              keyboard cannot reach fails WCAG 2.1.1 (axe
              scrollable-region-focusable), and the wide ramps table
              below scrolls at every width. */}
            <section class="table-scroll" tabindex="0" aria-label="Breakpoints">
              <table>
                <thead>
                  <tr>
                    <th>Breakpoint</th>
                    <th>Query</th>
                    <th>What changes</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td><code>--bp-phone</code></td>
                    <td><code>max-width: 768px</code></td>
                    <td>
                      The header's top band retires and the footer groups
                      collapse.
                    </td>
                  </tr>
                  <tr>
                    <td><code>--bp-sidebar</code></td>
                    <td><code>max-width: 991px</code></td>
                    <td>The two-column row stacks.</td>
                  </tr>
                  <tr>
                    <td><code>--bp-tablet</code></td>
                    <td><code>max-width: 1024px</code></td>
                    <td>The wide-image step.</td>
                  </tr>
                </tbody>
              </table>
            </section>
            <p>
              A wide one, scrolling in its own box. Every color primitive in the
              sheet, one row per family and one column per stop.
            </p>
            <section
              class="table-scroll"
              tabindex="0"
              aria-label="Color primitives"
            >
              <table>
                <thead>
                  <tr>
                    <th>Family</th>
                    {rampStops.map((stop) => <th>{stop}</th>)}
                  </tr>
                </thead>
                <tbody>
                  {rampRows.map((row) => <tr>
                    <td>{row.family}</td>
                    {row.cells.map((cell) => <td>
                      {cell ? <code>{cell}</code> : ""}
                    </td>)}
                  </tr>)}
                </tbody>
              </table>
            </section>
          </div>

          <h3>Tokens</h3>
          <div class="prose">
            <p>
              The roles components read, with the value each resolves to in the
              current theme and palette.
            </p>
            <Palette entries={tokenEntries} label="Tokens" />
          </div>

          <h3>Type scale</h3>
          <div class="prose">
            <p>
              The fluid size stops. Each line renders at its own token and names
              it.
            </p>
            <ul class="type-scale">
              {typeScale.map((s) => <li data-size={s} class={`type-scale-${s}`}>
                <code>--font-size-{s}</code> Sample text
              </li>)}
            </ul>
          </div>

          <h3>Prose specimen</h3>
          <div class="prose">
            <p>
              Placeholder body copy, demonstrating paragraph rhythm, inline
              <code>code</code>, and a <a href="#">placeholder link</a>.
            </p>
            <blockquote>
              A placeholder blockquote, boxed on the gray band.
            </blockquote>
            <ul>
              <li>Placeholder list item one</li>
              <li>Placeholder list item two</li>
            </ul>
            {/* Footnotes in the markup remark-gfm emits for a Markdown
              [^1] reference, verbatim, since the prose sheet styles
              nothing footnote-specific: the reference is a superscript
              link, the notes an ordered list under a heading, each with
              a return link. The heading shows on purpose: the system
              defines no .sr-only (prose.css, owner call 2026-09-09). */}
            <p>
              A sentence with a footnote
              reference.<sup
                ><a
                  href="#user-content-fn-1"
                  id="user-content-fnref-1"
                  data-footnote-ref
                  aria-describedby="footnote-label"
                  >1</a
                ></sup
              >
            </p>
            <section data-footnotes class="footnotes">
              <h2 class="sr-only" id="footnote-label">Footnotes</h2>
              <ol>
                <li id="user-content-fn-1">
                  <p>
                    A placeholder footnote, with the return link that Markdown
                    footnotes get.
                    <a
                      href="#user-content-fnref-1"
                      data-footnote-backref
                      aria-label="Back to reference 1"
                      class="data-footnote-backref"
                      >↩</a
                    >
                  </p>
                </li>
              </ol>
            </section>
          </div>

          <h3>Patterns</h3>
          {/* The same boxed ledger the token sheet wears (prose-scoped,
            the table lesson of 2026-09-06): live specimens, so the
            patterns follow theme flips and palette applies. The Used
            for column restates each class's documented purpose from
            patterns.css, not invented roles. */}
          <div class="prose">
            <section class="table-scroll" tabindex="0" aria-label="Patterns">
              <table class="demo-pattern-table">
                <thead>
                  <tr>
                    <th>Specimen</th>
                    <th>Class</th>
                    <th>Used for</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td><span class="chip">Chip</span></td>
                    <td><code>.chip</code></td>
                    <td>
                      Filled label. The read-time chip and the category card's
                      name.
                    </td>
                  </tr>
                  <tr>
                    <td><span class="boxed-label">Boxed label</span></td>
                    <td><code>.boxed-label</code></td>
                    <td>
                      Bordered box, typically straddling a frame rule. The
                      header's date box and widget titles.
                    </td>
                  </tr>
                  <tr>
                    <td>
                      <button
                        type="button"
                        class="icon-box"
                        aria-label="Placeholder icon button"
                      >
                        <Icon name="circle" size={16} strokeWidth={2} />
                      </button>
                    </td>
                    <td><code>.icon-box</code></td>
                    <td>
                      Bordered interactive square. Social icons, the search
                      magnifier, the palette panel's close box.
                    </td>
                  </tr>
                  <tr>
                    <td><span class="micro-label">Micro label</span></td>
                    <td><code>.micro-label</code></td>
                    <td>
                      Small bold tracked line. Plate labels and the lightbox's
                      HOME box.
                    </td>
                  </tr>
                  <tr>
                    <td>
                      <span class="caption"
                        >Caption text, quiet and small.</span
                      >
                    </td>
                    <td><code>.caption</code></td>
                    <td>
                      The quiet line under an image, beside media text, or after
                      a quote.
                    </td>
                  </tr>
                </tbody>
              </table>
            </section>
          </div>
        </section>
      </article>
    </main>
  </div>
</Base>

<style>
  .static-page h1 { font-size: var(--font-size-lg); margin: 0 0 15px; }
  section { margin-top: 40px; }

  .demo-npm-links {
    list-style: none;
    margin: 0 0 1.5em;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
  }

  .demo-card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 20px;
    margin: 20px 0;
  }
  .demo-card-grid-narrow { grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }

  /* The TwoColumn demo: a ruled frame standing in for the page the row
     would fill. The trailing paragraph and widget margins would only
     pad the frame's bottom edge, so they come off inside it. */
  .demo-two-column {
    border: var(--stroke) solid var(--rule);
    padding: 20px;
    margin: 20px 0;
  }

  .demo-two-column :global(.prose > p:last-child),
  .demo-two-column :global(.widget) { margin-bottom: 0; }

  /* The derived-excerpt demo: the sample body beside the card it
     yields, the card column the same third a card takes in the grid
     above; stacked where the sidebar row stacks. */
  .demo-excerpt {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(260px, 1fr);
    align-items: start;
    gap: 20px;
    margin: 20px 0;
  }
  .demo-excerpt > * { margin: 0; }

  @media (--bp-sidebar) {
    .demo-excerpt { grid-template-columns: minmax(0, 1fr); }
  }

  .demo-widget-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 30px;
    margin: 20px 0;
  }
</style>
