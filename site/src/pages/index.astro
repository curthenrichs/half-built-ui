---
/* The reference site's one page. Renders the chrome (through
   Base.astro) plus one instance of every component the brief asks
   for, fed by sample data defined right here, grouped under the
   anchored sections in ../data/sections.ts. Nothing on this page is
   blog content: the copy is plain and invented for the demo, and the
   images are generated geometric placeholders in ../assets. Every
   component import below is a package specifier into @half-built/astro;
   nothing reaches into packages/astro/src by relative path. */
import { Code } from "astro:components";
import Base from "../layouts/Base.astro";
import Toc from "../components/Toc.astro";
import EditorNote from "@half-built/astro/content/EditorNote.astro";
import ThemeToggle from "@half-built/astro/components/ThemeToggle.astro";
import PostCard from "@half-built/astro/components/PostCard.astro";
import CategoryCard from "@half-built/astro/components/CategoryCard.astro";
import Pagination from "@half-built/astro/components/Pagination.astro";
import PostNavigation from "@half-built/astro/components/PostNavigation.astro";
import LinkListWidget from "@half-built/astro/components/LinkListWidget.astro";
import Widget from "@half-built/astro/components/Widget.astro";
import Subscribe from "@half-built/astro/components/Subscribe.astro";
import Button from "@half-built/astro/content/Button.astro";
import Callout from "@half-built/astro/content/Callout.astro";
import Quote from "@half-built/astro/content/Quote.astro";
import Step from "@half-built/astro/content/Step.astro";
import Walkthrough from "@half-built/astro/content/Walkthrough.astro";
import Gallery from "@half-built/astro/content/Gallery.astro";
import GalleryImage from "@half-built/astro/content/GalleryImage.astro";
import BlogImage from "@half-built/astro/content/BlogImage.astro";
import MediaText from "@half-built/astro/content/MediaText.astro";
import CodeBlock from "@half-built/astro/content/CodeBlock.astro";
import Palette from "@half-built/astro/content/Palette.astro";
import Group from "@half-built/astro/content/Group.astro";
import Spacer from "@half-built/astro/content/Spacer.astro";
import codeTheme from "@half-built/astro/shiki/code-theme";
import codeVars from "@half-built/astro/shiki/code-vars";
import type { PostCardModel, PostRef, LinkListItem } from "@half-built/astro/components/models.ts";
import placeholderWide from "../assets/placeholder-wide.svg";
import placeholderSquare from "../assets/placeholder-square.svg";
import placeholderTall from "../assets/placeholder-tall.svg";

const posts: PostCardModel[] = [
  {
    href: "#",
    title: "Sample post, plain card",
    excerpt: "Placeholder excerpt text standing in for a real post summary.",
    author: "Demo Author",
    dateStr: "1, Jan 2026",
    minutes: 4,
    hero: placeholderWide,
    categories: [{ name: "Sample", href: "#" }],
  },
  {
    href: "#",
    title: "Sample post, marked draft",
    excerpt: "A second placeholder excerpt, this card flagged as a draft.",
    author: "Demo Author",
    dateStr: "2, Jan 2026",
    minutes: 6,
    hero: placeholderWide,
    draft: true,
    categories: [{ name: "Sample", href: "#" }, { name: "Demo", href: "#" }],
  },
  {
    href: "#",
    title: "Sample post, with corner badges",
    excerpt: "A third placeholder excerpt, showing the AI Art and Demo badges together.",
    author: "Demo Author",
    dateStr: "3, Jan 2026",
    minutes: 3,
    hero: placeholderWide,
    genai: true,
    demo: true,
    categories: [{ name: "Demo", href: "#" }],
  },
];

const categoryCards = [
  { name: "Sample", href: "#", image: placeholderSquare },
  { name: "Demo", href: "#", image: placeholderTall },
];

const prevPost: PostRef = { href: "#", title: "Older placeholder post" };
const nextPost: PostRef = { href: "#", title: "Newer placeholder post" };

const linkListItems: LinkListItem[] = [
  { label: "Item one", href: "#", count: 3 },
  { label: "Item two", href: "#", count: 1 },
  { label: "Item three", href: "#" },
];

/* The live token sheet (owner ask 2026-09-06): the old chip list and
   the old static Palette demo merged into one Palette table. Every
   entry carries `token`, so the chips follow the cascade and
   token-hexes.ts fills the hex cells from computed styles; theme
   flips and palette applies both move the values live. */
const tokenEntries = [
  { role: "--ink", token: "--ink", note: "Body text and rules" },
  { role: "--surface", token: "--surface", note: "The page ground" },
  { role: "--rule", token: "--rule", note: "Borders and frames" },
  { role: "--accent-1", token: "--accent-1", note: "Accent 1 lines and fills" },
  { role: "--accent-1-ink", token: "--accent-1-ink", note: "Accent 1 as readable text" },
  { role: "--accent-2", token: "--accent-2", note: "Accent 2 lines and fills" },
  { role: "--accent-2-ink", token: "--accent-2-ink", note: "Accent 2 as readable text" },
  { role: "--code-token-function", token: "--code-token-function", note: "Function names in code" },
  { role: "--code-token-string", token: "--code-token-string", note: "Strings and constants in code" },
];

const codeSample = `def read_ir(code):
    return "power" if code == 0x40BF else "unknown"`;

const npmPackages = [
  { name: "@half-built/css", href: "https://www.npmjs.com/package/@half-built/css" },
  { name: "@half-built/astro", href: "https://www.npmjs.com/package/@half-built/astro" },
  { name: "@half-built/tooling", href: "https://www.npmjs.com/package/@half-built/tooling" },
];
---
<Base title="half-built-ui" description="The reference site for the @half-built packages, every component's variants rendered on one page.">
  <div class="site-layout">
    <Toc />
    <article class="static-page bracket-frame">
      <h1>half-built-ui</h1>

      <section id="intro">
        <div class="prose no-hero">
          <h2>About</h2>
          <div class="section-intro" data-section-intro="intro">
            <p>This page renders every piece of the half-built design system in one place, so I can look at the whole thing at once. I pulled the system out of half-built-robots.com, and the blog still runs on it. The three packages are on npm under MIT.</p>
            <p>The palette editor in the corner rewrites the theming variables live and prints a block you can copy into your own stylesheet. That block is the entire theming surface, eight brand stops and the four values behind the code viewer. The viewer highlights through variables, so syntax colors and the warm block they sit on follow your palette too.</p>
          </div>
          <!-- A real CodeBlock, not an inline code span, so the code
               island mounts its COPY button on the install line (owner
               ask 2026-09-06). -->
          <CodeBlock>
            <Code code="npm install @half-built/css @half-built/astro @half-built/tooling" lang="shellscript" theme={codeTheme} transformers={[codeVars]} />
          </CodeBlock>
          <ul class="demo-npm-links">
            {npmPackages.map((pkg) => <li><a href={pkg.href}><code>{pkg.name}</code></a></li>)}
          </ul>
        </div>
      </section>

      <section id="frame">
        <div class="prose no-hero">
          <h2>Frame</h2>
          <div class="section-intro" data-section-intro="frame">
            <p>The header and footer around this page come from the package. Nothing in them knows about my blog. The site name and the rest of the identity arrive as typed props. The theme toggle flips the page between the light and dark palettes and remembers the choice. Every toggle on a page stays in step. Flip the standalone one below and the header's moves with it.</p>
            <EditorNote>What Curt has to supply: why the day and night toggle stays in the header while the palette editor lives in the corner.</EditorNote>
          </div>
          <p class="demo-imports"><code>@half-built/astro/components/Masthead.astro</code>, <code>@half-built/astro/components/Footer.astro</code>, <code>@half-built/astro/components/ThemeToggle.astro</code></p>
        </div>
        <p><ThemeToggle label="Switch theme (standalone demo)" /></p>
      </section>

      <section id="cards">
        <div class="prose no-hero">
          <h2>Cards</h2>
          <div class="section-intro" data-section-intro="cards">
            <p>PostCard is the card an archive page is made of. The second one here is flagged as a draft, and that badge exists so an unfinished post can ship where people can see it. The third wears the corner badges, one for an AI-generated image and one for a post carrying an interactive demo. CategoryCard is the smaller tile, an image with the category name chipped over its bottom edge.</p>
          </div>
          <p class="demo-imports"><code>@half-built/astro/components/PostCard.astro</code>, <code>@half-built/astro/components/CategoryCard.astro</code></p>
        </div>

        <h3>Post cards</h3>
        <div class="demo-card-grid">
          {posts.map((post) => <PostCard {...post} />)}
        </div>

        <h3>Category cards</h3>
        <div class="demo-card-grid demo-card-grid-narrow">
          {categoryCards.map((c) => <CategoryCard name={c.name} href={c.href} image={c.image} />)}
        </div>
      </section>

      <section id="navigation">
        <div class="prose no-hero">
          <h2>Navigation</h2>
          <div class="section-intro" data-section-intro="navigation">
            <p>Pagination is the numbered row at the foot of an archive, and it renders nothing at all when there is only one page. PostNavigation is the pair of links at the end of a post. The newer post sits on the left and the older one on the right. That is backwards from what WordPress did, and it matches the newest-first order the archives read in.</p>
          </div>
          <p class="demo-imports"><code>@half-built/astro/components/Pagination.astro</code>, <code>@half-built/astro/components/PostNavigation.astro</code></p>
        </div>

        <h3>Pagination</h3>
        <Pagination current={2} total={4} base="#" />

        <h3>Post navigation</h3>
        <PostNavigation prev={prevPost} next={nextPost} />
      </section>

      <section id="widgets">
        <div class="prose no-hero">
          <h2>Widgets</h2>
          <div class="section-intro" data-section-intro="widgets">
            <p>Widget is the plain sidebar block, a heading over whatever you put in its body. LinkListWidget is that same block filled with links and their counts. A recent-posts list and a category list are both just this widget. Subscribe is the newsletter panel. It is a real form with a method and an action, and it submits fine with JavaScript turned off. Its copy sits in named slots, so a site with a different voice overrides the words instead of forking the component.</p>
          </div>
          <p class="demo-imports"><code>@half-built/astro/components/Widget.astro</code>, <code>@half-built/astro/components/LinkListWidget.astro</code>, <code>@half-built/astro/components/Subscribe.astro</code></p>
        </div>

        <h3>Link list widget and Widget</h3>
        <div class="demo-widget-row">
          <LinkListWidget title="Sample links" items={linkListItems} />
          <Widget title="Plain widget">
            <p>A Widget with arbitrary content in its body, rather than the link-list shape above.</p>
          </Widget>
        </div>

        <h3>Subscribe</h3>
        <Subscribe variant="page" action="https://example.com/subscribe" publicUrl="example.com/subscribe">
          <Fragment slot="fine-print">Placeholder form. This demo does not send email. The action is not a real endpoint.</Fragment>
        </Subscribe>
      </section>

      <section id="content">
        <div class="prose no-hero">
          <h2>Content blocks</h2>
          <div class="section-intro" data-section-intro="content">
            <p>These are the blocks a post body is built from. Nothing here caps the width of the text, and nothing anywhere in this system does. The layout's column is the only width authority. The images below are generated placeholders rather than anything off the blog.</p>
            <EditorNote>What Curt has to supply: why the content blocks live under content/ while the site furniture lives under components/.</EditorNote>
          </div>
          <p class="demo-imports"><code>@half-built/astro/content/*</code></p>

          <h3>Button</h3>
          <p>Four variants, two sizes.</p>
          <p class="button-row">
            <Button variant="plain">Plain</Button>
            <Button variant="shaded">Shaded</Button>
            <Button variant="accent-1">Accent 1</Button>
            <Button variant="accent-2" size="lg">Accent 2, large</Button>
          </p>

          <h3>Callout</h3>
          <Callout type="note">A note callout, the default look.</Callout>
          <Callout type="tip" title="Tip">A tip callout, wearing the first accent.</Callout>
          <Callout type="success">A success callout, wearing the second accent.</Callout>
          <Callout type="error">An error callout, in the red family.</Callout>

          <h3>Editor's note</h3>
          <p>The reminder that never ships. By default it renders only on a dev server. A deploy build emits nothing for it, so a note can sit in published content as a standing to-do. This one is forced visible with the <code>shown</code> prop so the page can show it.</p>
          <EditorNote title="Demo" shown={true}>A demo note, forced visible. The dashed rule is the tell. Nothing else in the system is dashed.</EditorNote>

          <h3>Group</h3>
          <Group><p>A boxed prose container, no label and no tint, the plain sibling of Callout's box.</p></Group>

          <h3>Quote</h3>
          <Quote by="Demo Author" when="2026">A quoted line, with an attribution footer.</Quote>

          <h3>Walkthrough and Step</h3>
          <Walkthrough numbered>
            <Step src={placeholderSquare} alt="Placeholder step photo, one">First step. One placeholder photo beside its text.</Step>
            <Step src={placeholderSquare} alt="Placeholder step photo, two">Second step. Numbering runs down the media column's corner chip.</Step>
          </Walkthrough>

          <h3>Gallery</h3>
          <Gallery columns={3} caption="Three placeholder plates in a bracket frame.">
            <GalleryImage src={placeholderSquare} alt="Placeholder gallery plate, one" caption="Plate one" />
            <GalleryImage src={placeholderSquare} alt="Placeholder gallery plate, two" caption="Plate two" />
            <GalleryImage src={placeholderSquare} alt="Placeholder gallery plate, three" caption="Plate three" />
          </Gallery>

          <h3>Blog image</h3>
          <BlogImage src={placeholderWide} alt="Wide placeholder image" caption="A full-width figure with a caption." />

          <h3>Media text</h3>
          <MediaText src={placeholderTall} alt="Tall placeholder image">
            <p>Media on one side, prose on the other. This is the caption slot, and it takes a short paragraph rather than a single line.</p>
          </MediaText>

          <h3>Code block</h3>
          <CodeBlock filename="example.py">
            <Code code={codeSample} lang="python" theme={codeTheme} transformers={[codeVars]} />
          </CodeBlock>

          <h3>Palette</h3>
          <p>The color table component. Its real instance on this page is the live token sheet in the CSS primitives section, so it is not repeated here.</p>

          <h3>Spacer</h3>
          <p>A fixed-height spacer sits below this paragraph.</p>
          <Spacer size={60} />
          <p>Normal flow resumes here, after the spacer.</p>
        </div>
      </section>

      <section id="css">
        <div class="prose no-hero">
          <h2>CSS primitives</h2>
          <div class="section-intro" data-section-intro="css">
            <p>The tokens are the variables everything else reads, and every color on this page comes out of them. The palette editor repaints the whole page by setting twelve of them. The light-theme amber ink started out borrowed from a prototype of another project. It sat at 4.24 to 1 against white, which fails WCAG AA, so I retuned it until it passed. The prose and pattern sheets carry the rest, the paragraph rhythm and the boxes.</p>
          </div>
          <p class="demo-imports"><code>@half-built/css/tokens</code>, <code>@half-built/css/prose.css</code>, <code>@half-built/css/patterns.css</code></p>
        </div>

        <h3>Tokens</h3>
        {/* Inside prose scope on purpose: the boxed ledger table
            treatment lives in prose.css as .prose table, which is how
            every table on the blog wears it. Outside this wrapper the
            sheet renders as a bare default table. */}
        <div class="prose">
          <Palette entries={tokenEntries} />
        </div>

        <h3>Prose specimen</h3>
        <div class="prose">
          <p>Placeholder body copy, demonstrating paragraph rhythm, inline <code>code</code>, and a <a href="#">placeholder link</a>.</p>
          <blockquote>A placeholder blockquote, boxed on the gray band.</blockquote>
          <ul>
            <li>Placeholder list item one</li>
            <li>Placeholder list item two</li>
          </ul>
        </div>

        <h3>Patterns</h3>
        <p class="button-row">
          <span class="chip">Chip</span>
          <span class="boxed-label">Boxed label</span>
          <button type="button" class="icon-box" aria-label="Placeholder icon button">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /></svg>
          </button>
        </p>
        <p class="micro-label">Micro label</p>
        <p class="caption">Caption text, quiet and small.</p>
      </section>
    </article>
  </div>
</Base>

<style>
  .static-page h1 { font-size: var(--font-size-lg); margin: 0 0 15px; }
  section { margin-top: 40px; }
  .demo-npm-links {
    list-style: none;
    margin: 0 0 1.5em;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
  }
  .demo-card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 20px;
    margin: 20px 0;
  }
  .demo-card-grid-narrow { grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
  .demo-widget-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 30px;
    margin: 20px 0;
  }
</style>
