---
import { Code } from "astro:components";
import Base from "../layouts/Base.astro";
import Rail from "../components/Rail.astro";
import Imports from "../components/Imports.astro";
import EditorNote from "@half-built/astro/content/EditorNote.astro";
import WhenPublished from "@half-built/astro/content/WhenPublished.astro";
import PostLink from "@half-built/astro/content/PostLink.astro";
import PostCard from "@half-built/astro/components/PostCard.astro";
import CategoryCard from "@half-built/astro/components/CategoryCard.astro";
import Pagination from "@half-built/astro/components/Pagination.astro";
import Icon from "@half-built/astro/components/Icon.astro";
import PostNavigation from "@half-built/astro/components/PostNavigation.astro";
import LinkListWidget from "@half-built/astro/components/LinkListWidget.astro";
import Widget from "@half-built/astro/components/Widget.astro";
import Subscribe from "@half-built/astro/components/Subscribe.astro";
import Button from "@half-built/astro/content/Button.astro";
import Callout from "@half-built/astro/content/Callout.astro";
import Quote from "@half-built/astro/content/Quote.astro";
import Step from "@half-built/astro/content/Step.astro";
import Walkthrough from "@half-built/astro/content/Walkthrough.astro";
import Gallery from "@half-built/astro/content/Gallery.astro";
import GalleryImage from "@half-built/astro/content/GalleryImage.astro";
import BlogImage from "@half-built/astro/content/BlogImage.astro";
import MediaText from "@half-built/astro/content/MediaText.astro";
import CodeBlock from "@half-built/astro/content/CodeBlock.astro";
import Palette from "@half-built/astro/content/Palette.astro";
import Group from "@half-built/astro/content/Group.astro";
import Spacer from "@half-built/astro/content/Spacer.astro";
import codeTheme from "@half-built/astro/shiki/code-theme";
import codeVars from "@half-built/astro/shiki/code-vars";
import type {
  PostCardModel,
  PostRef,
  LinkListItem,
} from "@half-built/astro/components/models.ts";
import placeholderWide from "../assets/placeholder-wide.svg";
import placeholderSquare from "../assets/placeholder-square.svg";
import placeholderTall from "../assets/placeholder-tall.svg";

const posts: PostCardModel[] = [
  {
    href: "#",
    title: "Sample post, plain card",
    excerpt: "Placeholder excerpt text standing in for a real post summary.",
    author: "Demo Author",
    dateStr: "1, Jan 2026",
    minutes: 4,
    hero: placeholderWide,
    categories: [{ name: "Sample", href: "#" }],
  },
  {
    href: "#",
    title: "Sample post, marked draft",
    excerpt: "A second placeholder excerpt, this card flagged as a draft.",
    author: "Demo Author",
    dateStr: "2, Jan 2026",
    minutes: 6,
    hero: placeholderWide,
    draft: true,
    categories: [
      { name: "Sample", href: "#" },
      { name: "Demo", href: "#" },
    ],
  },
  {
    href: "#",
    title: "Sample post, with corner badges",
    excerpt:
      "A third placeholder excerpt, showing the AI Art and Demo badges together.",
    author: "Demo Author",
    dateStr: "3, Jan 2026",
    minutes: 3,
    hero: placeholderWide,
    genai: true,
    demo: true,
    categories: [{ name: "Demo", href: "#" }],
  },
];

const categoryCards = [
  { name: "Sample", href: "#", image: placeholderSquare },
  { name: "Demo", href: "#", image: placeholderTall },
];

const prevPost: PostRef = { href: "#", title: "Older placeholder post" };
const nextPost: PostRef = { href: "#", title: "Newer placeholder post" };

const linkListItems: LinkListItem[] = [
  { label: "Item one", href: "#", count: 3 },
  { label: "Item two", href: "#", count: 1 },
  { label: "Item three", href: "#" },
];

const tokenEntries = [
  { role: "--ink", token: "--ink", note: "Body text and rules" },
  { role: "--surface", token: "--surface", note: "The page ground" },
  { role: "--rule", token: "--rule", note: "Borders and frames" },
  { role: "--accent-1", token: "--accent-1", note: "Accent 1 lines and fills" },
  {
    role: "--accent-1-ink",
    token: "--accent-1-ink",
    note: "Accent 1 as readable text",
  },
  { role: "--accent-2", token: "--accent-2", note: "Accent 2 lines and fills" },
  {
    role: "--accent-2-ink",
    token: "--accent-2-ink",
    note: "Accent 2 as readable text",
  },
  {
    role: "--error-ink",
    token: "--error-ink",
    note: "The error callout's line and label",
  },
  {
    role: "--code-token-function",
    token: "--code-token-function",
    note: "Function names in code",
  },
  {
    role: "--code-token-string",
    token: "--code-token-string",
    note: "Strings and constants in code",
  },
];

import primitivesSheet from "@half-built/css/tokens/primitives.css?raw";

const STOP = /^(\d+|a\d+|vivid|dim)$/;

const stopOrder = (stop: string): number => {
  if (stop === "plain") return -1;
  if (/^\d+$/.test(stop)) return Number(stop);
  return (
    1000 +
    ["vivid", "dim"].indexOf(stop) +
    (stop.startsWith("a") ? 100 + Number(stop.slice(1)) : 0)
  );
};

const ramps = new Map<string, Map<string, string>>();

for (const m of primitivesSheet.matchAll(
  /--([a-z0-9-]+):\s*((?:#|rgba?\()[^;]+);/g,
)) {
  const [, name, value] = m;
  const parts = name.split("-");
  const last = parts[parts.length - 1];
  const stop = STOP.test(last) ? last : "plain";
  const family = stop === "plain" ? name : parts.slice(0, -1).join("-");
  const row = ramps.get(family) ?? new Map<string, string>();
  row.set(stop, value.trim());
  ramps.set(family, row);
}

const rampStops = [
  ...new Set([...ramps.values()].flatMap((row) => [...row.keys()])),
].sort((a, b) => stopOrder(a) - stopOrder(b));

const rampRows = [...ramps.entries()].map(([family, row]) => ({
  family,
  cells: rampStops.map((stop) => row.get(stop) ?? ""),
}));

const samplePosts = [
  {
    data: {
      slug: "sample-published",
      date: new Date("2026-09-01T00:00:00Z"),
      draft: false,
    },
  },
  {
    data: {
      slug: "sample-draft",
      date: new Date("2026-09-08T00:00:00Z"),
      draft: true,
    },
  },
];

const codeSample = `def read_ir(code):
    return "power" if code == 0x40BF else "unknown"`;

const frameImports = `import Masthead from "@half-built/astro/components/Masthead.astro";
import Footer from "@half-built/astro/components/Footer.astro";
import ThemeToggle from "@half-built/astro/components/ThemeToggle.astro";`;

const cardImports = `import PostCard from "@half-built/astro/components/PostCard.astro";
import CategoryCard from "@half-built/astro/components/CategoryCard.astro";`;

const componentImports = `import Pagination from "@half-built/astro/components/Pagination.astro";
import PostNavigation from "@half-built/astro/components/PostNavigation.astro";
import Widget from "@half-built/astro/components/Widget.astro";
import LinkListWidget from "@half-built/astro/components/LinkListWidget.astro";
import Subscribe from "@half-built/astro/components/Subscribe.astro";
import Button from "@half-built/astro/content/Button.astro";
import Callout from "@half-built/astro/content/Callout.astro";
import EditorNote from "@half-built/astro/content/EditorNote.astro";
import WhenPublished from "@half-built/astro/content/WhenPublished.astro";
import PostLink from "@half-built/astro/content/PostLink.astro";
import Group from "@half-built/astro/content/Group.astro";
import CodeBlock from "@half-built/astro/content/CodeBlock.astro";
import Spacer from "@half-built/astro/content/Spacer.astro";
import Quote from "@half-built/astro/content/Quote.astro";
import Walkthrough from "@half-built/astro/content/Walkthrough.astro";
import Step from "@half-built/astro/content/Step.astro";
import Gallery from "@half-built/astro/content/Gallery.astro";
import GalleryImage from "@half-built/astro/content/GalleryImage.astro";
import BlogImage from "@half-built/astro/content/BlogImage.astro";
import MediaText from "@half-built/astro/content/MediaText.astro";`;

const cssImports = `import "@half-built/css/tokens";
import "@half-built/css/prose.css";
import "@half-built/css/patterns.css";
import Palette from "@half-built/astro/content/Palette.astro";`;

const npmPackages = [
  {
    name: "@half-built/css",
    href: "https://www.npmjs.com/package/@half-built/css",
  },
  {
    name: "@half-built/astro",
    href: "https://www.npmjs.com/package/@half-built/astro",
  },
  {
    name: "@half-built/tooling",
    href: "https://www.npmjs.com/package/@half-built/tooling",
  },
];
---

<Base
  title="half-built-ui"
  description="The reference site for the @half-built packages, every component's variants rendered on one page."
>
  <div class="site-layout">
    <Rail />
    <article class="static-page bracket-frame">
      <h1>half-built-ui</h1>

      <section id="intro">
        <div class="prose">
          <h2>About</h2>
          <div class="section-intro" data-section-intro="intro">
            <p>
              This page renders every component in the half-built design system.
              The system was extracted from
              <a href="https://half-built-robots.com">half-built-robots.com</a>,
              which now references these packages. All three packages are
              published on npm under MIT.
            </p>
            <p>
              The palette editor in the corner rewrites the theming variables
              live and prints a block ready to paste into a stylesheet. That
              block is the entire theming surface, eight brand stops plus the
              four values behind the code viewer. The viewer highlights through
              those variables, so syntax colors and the block they sit on follow
              the palette as well.
            </p>
          </div>
          <!-- A real CodeBlock, not an inline code span, so the code
               island mounts its COPY button on the install line (owner
               ask 2026-09-06). -->
          <CodeBlock>
            <Code
              code="npm install @half-built/css @half-built/astro @half-built/tooling"
              lang="shellscript"
              theme={codeTheme}
              transformers={[codeVars]}
            />
          </CodeBlock>
          <ul class="demo-npm-links">
            {npmPackages.map((pkg) => <li>
              <a href={pkg.href}><code>{pkg.name}</code></a>
            </li>)}
          </ul>
        </div>
      </section>

      <section id="frame">
        <div class="prose">
          <h2>Frame</h2>
          <div class="section-intro" data-section-intro="frame">
            <p>
              The header and footer come from the package and know nothing about
              the site around them. The site name and the rest of the identity
              arrive as typed props. The theme toggle sits in the header, and
              the palette panel carries a second instance beside the color
              pickers. Every toggle on a page stays in step, so flipping either
              one moves the other.
            </p>
          </div>
          <Imports code={frameImports} />
        </div>
      </section>

      <section id="cards">
        <div class="prose">
          <h2>Cards</h2>
          <div class="section-intro" data-section-intro="cards">
            <p>
              PostCard is the card an archive page is made of. The second one
              here is flagged as a draft, and that badge exists so an unfinished
              post can ship where people can see it. The third wears the corner
              badges, one for an AI-generated image and one for a post carrying
              an interactive demo. CategoryCard is the smaller tile, an image
              with the category name chipped over its bottom edge.
            </p>
          </div>
          <Imports code={cardImports} />
        </div>

        <h3>Post cards</h3>
        <div class="demo-card-grid">
          {posts.map((post) => (
            <PostCard {...post} />
          ))}
        </div>

        <h3>Category cards</h3>
        <div class="demo-card-grid demo-card-grid-narrow">
          {categoryCards.map((c) => (
            <CategoryCard name={c.name} href={c.href} image={c.image} />
          ))}
        </div>
      </section>

      <section id="components">
        <div class="prose">
          <h2>Components</h2>
          <div class="section-intro" data-section-intro="components">
            <p>
              The rest of the package, from the navigation rows to the blocks a
              post body is built from. Imports split between
              <code>components/</code> for page chrome and <code>content/</code>
              for post bodies. The split is only where the files live. Nothing
              in this system caps the width of text. The layout's column is the
              only width authority.
            </p>
          </div>
          <Imports code={componentImports} />
        </div>

        <div class="prose">
          <h3>Pagination</h3>
          <p>
            The numbered row at the foot of an archive. It renders nothing when
            there is only one page.
          </p>
        </div>
        <Pagination current={2} total={4} base="#" />

        <div class="prose">
          <h3>Post navigation</h3>
          <p>
            The pair of links at the end of a post. The newer post sits on the
            left and the older one on the right, matching the newest-first order
            the archives read in.
          </p>
        </div>
        <PostNavigation prev={prevPost} next={nextPost} />

        <div class="prose">
          <h3>Link list widget and Widget</h3>
          <p>
            Widget is a heading over whatever sits in its body. LinkListWidget
            is that same block filled with links and their counts.
          </p>
        </div>
        <div class="demo-widget-row">
          <LinkListWidget title="Sample links" items={linkListItems} />
          <Widget title="Plain widget">
            <p>
              A Widget with arbitrary content in its body, rather than the
              link-list shape above.
            </p>
          </Widget>
        </div>

        <div class="prose">
          <h3>Subscribe</h3>
          <p>
            A real form with a method and an action, which submits with
            JavaScript turned off. Its copy sits in named slots, so the words
            can be overridden without forking the component.
          </p>
        </div>
        <Subscribe
          variant="page"
          action="https://example.com/subscribe"
          publicUrl="example.com/subscribe"
        >
          <Fragment slot="fine-print"
            >Placeholder form. This demo does not send email. The action is not
            a real endpoint.</Fragment
          >
        </Subscribe>

        <div class="prose">
          <h3>Button</h3>
          <p>Four variants, two sizes.</p>
          <p class="button-row">
            <Button variant="plain">Plain</Button>
            <Button variant="shaded">Shaded</Button>
            <Button variant="accent-1">Accent 1</Button>
            <Button variant="accent-2" size="lg">Accent 2, large</Button>
          </p>
          <p>A lone call to action takes the centered row.</p>
          <p class="button-row button-row-center">
            <Button variant="accent-2" href="#">Centered call to action</Button>
          </p>

          <h3>Callout</h3>
          <p>
            An aside set apart from the body, for a caveat, a warning, or a
            result the reader should not skim past. The type sets the label and
            the line color.
          </p>
          <Callout type="note">A note callout, the default look.</Callout>
          <Callout type="info"
            >An info callout, graphite like the note. The label tells them
            apart.</Callout
          >
          <Callout type="tip" title="Tip"
            >A tip callout, wearing the first accent.</Callout
          >
          <Callout type="warning"
            >A warning callout, the first accent again.</Callout
          >
          <Callout type="success"
            >A success callout, wearing the second accent.</Callout
          >
          <Callout type="error">An error callout, in the red family.</Callout>

          <h3>Editor's note</h3>
          <p>
            A note to the author that renders only on a dev server. A deploy
            build emits nothing for it, so it can sit in published content as a
            standing to-do. This one is forced visible with the
            <code>shown</code> prop.
          </p>
          <EditorNote title="Demo" shown={true}
            >A demo note, forced visible. The dashed rule is the tell. Nothing
            else in the system is dashed.</EditorNote
          >

          <h3>When published and Post link</h3>
          <p>
            Both take the consumer's post collection as a prop and read no
            content of their own. <code>PostLink</code> resolves a slug to the
            post's dated URL at build time. <code>WhenPublished</code> renders
            its passage only once the post it names is visible, so a draft can
            be teased before it ships. The sample collection here has one
            published post and one draft. The first passage shows, the second is
            absent from this page.
          </p>
          <WhenPublished slug="sample-published" posts={samplePosts}>
            <p>
              This passage is visible because its post is published. It links to
              <PostLink
                slug="sample-published"
                posts={samplePosts}
                tip="Sample post (September 1, 2026)"
                >the sample post</PostLink
              >, whose URL was resolved from the slug.
            </p>
          </WhenPublished>
          <WhenPublished slug="sample-draft" posts={samplePosts}>
            <p class="sample-draft-passage">
              This passage never renders, because its post is a draft.
            </p>
          </WhenPublished>

          <h3>Group</h3>
          <Group
            ><p>
              A boxed prose container, no label and no tint, the plain sibling
              of Callout's box.
            </p></Group
          >

          <h3>Code block</h3>
          <CodeBlock filename="example.py">
            <Code
              code={codeSample}
              lang="python"
              theme={codeTheme}
              transformers={[codeVars]}
            />
          </CodeBlock>

          <h3>Spacer</h3>
          <p>A fixed-height spacer sits below this paragraph.</p>
          <Spacer size={60} />
          <p>Normal flow resumes here, after the spacer.</p>

          <h3>Quote</h3>
          <Quote by="Demo Author" when="2026"
            >A quoted line, with an attribution footer.</Quote
          >

          <h3>Walkthrough and Step</h3>
          <Walkthrough numbered>
            <Step src={placeholderSquare} alt="Placeholder step photo, one"
              >First step. One placeholder photo beside its text.</Step
            >
            <Step src={placeholderSquare} alt="Placeholder step photo, two"
              >Second step. Numbering runs down the media column's corner
              chip.</Step
            >
          </Walkthrough>

          <h3>Gallery</h3>
          <Gallery
            columns={3}
            caption="Three placeholder plates in a bracket frame."
          >
            <GalleryImage
              src={placeholderSquare}
              alt="Placeholder gallery plate, one"
              caption="Plate one"
            />
            <GalleryImage
              src={placeholderSquare}
              alt="Placeholder gallery plate, two"
              caption="Plate two"
            />
            <GalleryImage
              src={placeholderSquare}
              alt="Placeholder gallery plate, three"
              caption="Plate three"
            />
          </Gallery>

          <h3>Blog image</h3>
          <BlogImage
            src={placeholderWide}
            alt="Wide placeholder image"
            caption="A full-width figure with a caption."
          />

          <h3>Media text</h3>
          <MediaText src={placeholderTall} alt="Tall placeholder image">
            <p>
              Media on one side, prose on the other. This is the caption slot,
              and it takes a short paragraph rather than a single line. On a
              phone the two stack, image first, and the prose centers under it
              like a figure caption.
            </p>
          </MediaText>
        </div>
      </section>

      <section id="css">
        <div class="prose">
          <h2>CSS primitives</h2>
          <div class="section-intro" data-section-intro="css">
            <p>
              The tokens are the variables everything else reads, and every
              color on this page resolves through them. The palette editor
              repaints the page by setting twelve. Each value is tuned to clear
              WCAG AA against the ground it sits on. The prose and pattern
              sheets carry the rest, the paragraph rhythm and the boxes.
            </p>
          </div>
          <Imports code={cssImports} />
        </div>

        <h3>Table</h3>
        {/* Inside prose scope on purpose: the boxed ledger table
            treatment lives in prose.css as .prose table, which is how
            every table on the blog wears it. Outside this wrapper a
            table renders bare. The specimen's rows are the system's
            own breakpoints (tokens/breakpoints.css), real data rather
            than filler; the token sheet and the Patterns ledger below
            wear the same treatment. */}
        <div class="prose">
          <p>
            The boxed ledger every table in the system wears. Wide tables scroll
            inside their own box, so the page never scrolls sideways.
          </p>
          {/* Scroll boxes are named sections, so tab stops with a
              landmark name: a region that scrolls sideways and a
              keyboard cannot reach fails WCAG 2.1.1 (axe
              scrollable-region-focusable), and the wide ramps table
              below scrolls at every width. */}
          <section class="table-scroll" tabindex="0" aria-label="Breakpoints">
            <table>
              <thead>
                <tr>
                  <th>Breakpoint</th>
                  <th>Query</th>
                  <th>What changes</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><code>--bp-phone</code></td>
                  <td><code>max-width: 768px</code></td>
                  <td>
                    The header's top band retires and the footer groups
                    collapse.
                  </td>
                </tr>
                <tr>
                  <td><code>--bp-sidebar</code></td>
                  <td><code>max-width: 991px</code></td>
                  <td>The two-column row stacks.</td>
                </tr>
                <tr>
                  <td><code>--bp-tablet</code></td>
                  <td><code>max-width: 1024px</code></td>
                  <td>The wide-image step.</td>
                </tr>
              </tbody>
            </table>
          </section>
          <p>
            A wide one, scrolling in its own box. Every color primitive in the
            sheet, one row per family and one column per stop.
          </p>
          <section
            class="table-scroll"
            tabindex="0"
            aria-label="Color primitives"
          >
            <table>
              <thead>
                <tr>
                  <th>Family</th>
                  {rampStops.map((stop) => <th>{stop}</th>)}
                </tr>
              </thead>
              <tbody>
                {rampRows.map((row) => <tr>
                  <td>{row.family}</td>
                  {row.cells.map((cell) => <td>
                    {cell ? <code>{cell}</code> : ""}
                  </td>)}
                </tr>)}
              </tbody>
            </table>
          </section>
        </div>

        <h3>Tokens</h3>
        <div class="prose">
          <p>
            The roles components read, with the value each resolves to in the
            current theme and palette.
          </p>
          <Palette entries={tokenEntries} label="Tokens" />
        </div>

        <h3>Prose specimen</h3>
        <div class="prose">
          <p>
            Placeholder body copy, demonstrating paragraph rhythm, inline
            <code>code</code>, and a <a href="#">placeholder link</a>.
          </p>
          <blockquote>
            A placeholder blockquote, boxed on the gray band.
          </blockquote>
          <ul>
            <li>Placeholder list item one</li>
            <li>Placeholder list item two</li>
          </ul>
          {/* Footnotes in the markup remark-gfm emits for a Markdown
              [^1] reference, verbatim, since the prose sheet styles
              nothing footnote-specific: the reference is a superscript
              link, the notes an ordered list under a heading, each with
              a return link. The heading shows on purpose: the system
              defines no .sr-only (prose.css, owner call 2026-09-09). */}
          <p>
            A sentence with a footnote
            reference.<sup
              ><a
                href="#user-content-fn-1"
                id="user-content-fnref-1"
                data-footnote-ref
                aria-describedby="footnote-label"
                >1</a
              ></sup
            >
          </p>
          <section data-footnotes class="footnotes">
            <h2 class="sr-only" id="footnote-label">Footnotes</h2>
            <ol>
              <li id="user-content-fn-1">
                <p>
                  A placeholder footnote, with the return link that Markdown
                  footnotes get.
                  <a
                    href="#user-content-fnref-1"
                    data-footnote-backref
                    aria-label="Back to reference 1"
                    class="data-footnote-backref"
                    >↩</a
                  >
                </p>
              </li>
            </ol>
          </section>
        </div>

        <h3>Patterns</h3>
        {/* The same boxed ledger the token sheet wears (prose-scoped,
            the table lesson of 2026-09-06): live specimens, so the
            patterns follow theme flips and palette applies. The Used
            for column restates each class's documented purpose from
            patterns.css, not invented roles. */}
        <div class="prose">
          <section class="table-scroll" tabindex="0" aria-label="Patterns">
            <table class="demo-pattern-table">
              <thead>
                <tr>
                  <th>Specimen</th>
                  <th>Class</th>
                  <th>Used for</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><span class="chip">Chip</span></td>
                  <td><code>.chip</code></td>
                  <td>
                    Filled label. The read-time chip and the category card's
                    name.
                  </td>
                </tr>
                <tr>
                  <td><span class="boxed-label">Boxed label</span></td>
