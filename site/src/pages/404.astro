---
import Base from "../layouts/Base.astro";
---

<Base
  title="Page not found"
  description="This page does not exist on ui.half-built-robots.com."
  noindex
>
  <main>
    <article class="static-page bracket-frame">
      <h1>Page not found</h1>
      <div class="prose">
        <p>
          Nothing lives at this address. It may have moved, or the link may be
          mistyped.
        </p>
        <p><a href="/">Back to the reference site</a></p>
      </div>
    </article>
  </main>
</Base>
